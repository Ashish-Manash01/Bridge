# =============================================================================
# BRIDGE configuration. Copy to `.env` (repo root) and fill in what you need.
# Never commit real keys. Every secret is used only by the backend.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
# development | staging | production | test
BRIDGE_ENV=development
# Long random string used to sign guest tokens. REQUIRED in production.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# SQLite for local dev; PostgreSQL (e.g. Supabase) in production:
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./bridge.db
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: folder with the exported web app (apps/web/out) to serve it from the API (single-origin deploy).
STATIC_DIR=
LOG_LEVEL=INFO

# --- Providers ------------------------------------------------------------------
# Speech-to-text: browser (on-device Web Speech API, no key) | sarvam | google | openai
STT_PROVIDER=browser
# Translation: mymemory (free, daily quota, no key) | sarvam | google | openai | anthropic
TRANSLATION_PROVIDER=mymemory
# Optional second provider tried when the first fails (e.g. mymemory as backup for sarvam).
TRANSLATION_FALLBACK_PROVIDER=
# Text-to-speech: browser (device voices, no key) | sarvam | google | openai
TTS_PROVIDER=browser
# AI summaries (optional): none | anthropic | openai
SUMMARY_PROVIDER=none
# Mock providers are for automated tests only. Leave false.
ALLOW_MOCK_PROVIDERS=false

# Sarvam AI (recommended for Indian languages: STT + translation + TTS with one key)
# https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TRANSLATE_MODEL=mayura:v1
# formal = native script throughout | classic-colloquial | modern-colloquial (mixes English words)
SARVAM_TRANSLATE_MODE=formal
SARVAM_TTS_MODEL=bulbul:v3
# Empty = Sarvam's default voice. bulbul:v3 voices include priya, kavya, rahul, amit.
SARVAM_TTS_SPEAKER=

# Google Cloud (Speech-to-Text v1, Translation v2, Text-to-Speech). API key restricted to those APIs.
GOOGLE_API_KEY=

# OpenAI (transcription, LLM translation/summaries, TTS)
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Anthropic (context-aware translation with glossary, and summaries)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional operator contact email for MyMemory: raises its free quota (5k → 50k chars/day).
MYMEMORY_CONTACT_EMAIL=

PROVIDER_TIMEOUT_SECONDS=15

# --- Languages ----------------------------------------------------------------
# Languages offered in the app. Add later candidates (bn,mr,gu,pa,ur,es,fr,de,ar)
# only after running scripts/evaluate_providers.py and a human review.
ENABLED_LANGUAGES=en,hi,kn,ta,te,ml

# --- Limits & cost controls ---------------------------------------------------------
GUEST_TOKEN_TTL_MINUTES=240
ROOM_TTL_HOURS=6
MAX_PARTICIPANTS_PER_ROOM=12
MAX_UTTERANCE_SECONDS=30
MAX_AUDIO_BYTES=2000000
MAX_TEXT_CHARS=600
MAX_UTTERANCES_PER_PARTICIPANT=300
MAX_AUDIO_SECONDS_PER_ROOM=3600
MAX_TRANSLATE_CHARS_PER_ROOM=200000
TRANSLATION_CONTEXT_TURNS=4
RATE_CREATE_ROOM_PER_HOUR=20
RATE_JOIN_PER_MINUTE=12
RATE_UTTERANCE_PER_MINUTE=20
RATE_WRITE_PER_MINUTE=40

# --- Web app (build-time, public) --------------------------------------------------
# Only needed when the web app is hosted separately from the API (e.g. Vercel + Render).
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
# NEXT_PUBLIC_WEB_URL=https://your-domain.com
